{
  "name": "ttb-label-verification",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted TTB alcohol beverage label verification prototype",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "node server/src/index.js",
    "test": "npm run test -w server",
    "samples": "node scripts/generate-samples.js",
    "heroku-postbuild": "npm run build -w web"
  },
  "devDependencies": {
    "concurrently": "9.1.2"
  }
}
